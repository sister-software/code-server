+        // symlink can take its place (ignored if the target is a dir / absent).
+        generic_unlinkat(AT_PWD, point_raw);
+        return fakefs_bind_mount(point_raw, host, (flags & MS_READONLY_) != 0);
+    }
+
+    // Ignore MS_REC / MS_SILENT (recursion + log-suppression hints we can't act
+    // on) when validating the remaining flags.
+    if (flags & ~MS_SUPPORTED & ~MS_REC_) {
+        FIXME("missing mount flags %#x", flags & ~MS_SUPPORTED & ~MS_REC_);
         return _EINVAL;
     }
 
diff --git a/fs/proc/pid.c b/fs/proc/pid.c
index 05861c7..5b6b475 100644
--- a/fs/proc/pid.c
+++ b/fs/proc/pid.c
@@ -340,17 +340,128 @@ static int proc_pid_cwd_readlink(struct proc_entry *entry, char *buf) {
 }
 
 
+// /proc/<pid>/status — human-readable process info. Container runtimes
+// (crun/podman) read /proc/self/status for uid/gid maps and capabilities and
+// abort ("open /proc/self/status: no such file or directory") without it.
+static int proc_pid_status_show(struct proc_entry *entry, struct proc_data *buf) {
+    struct task *task = proc_get_task(entry);
+    if (task == NULL)
+        return _ESRCH;
+    lock(&task->general_lock);
+    lock(&task->group->lock);
+
+    proc_printf(buf, "Name:\t%.16s\n", task->comm);
+    proc_printf(buf, "State:\t%s\n",
+            task->zombie ? "Z (zombie)" :
+            task->group->stopped ? "T (stopped)" : "R (running)");
+    proc_printf(buf, "Tgid:\t%d\n", task->tgid);
+    proc_printf(buf, "Pid:\t%d\n", task->pid);
+    proc_printf(buf, "PPid:\t%d\n", task->parent ? task->parent->pid : 0);
+    proc_printf(buf, "TracerPid:\t0\n");
+    proc_printf(buf, "Uid:\t%d\t%d\t%d\t%d\n", task->uid, task->euid, task->suid, task->euid);
+    proc_printf(buf, "Gid:\t%d\t%d\t%d\t%d\n", task->gid, task->egid, task->sgid, task->egid);
+    proc_printf(buf, "FDSize:\t256\n");
+    proc_printf(buf, "Groups:");
+    for (unsigned i = 0; i < task->ngroups; i++)
+        proc_printf(buf, " %d", task->groups[i]);
+    proc_printf(buf, "\n");
+    proc_printf(buf, "Threads:\t%d\n", list_size(&task->group->threads));
+    // Capabilities aren't enforced; report the full set (matches sys_capget).
+    proc_printf(buf, "CapInh:\t0000000000000000\n");
+    proc_printf(buf, "CapPrm:\t000001ffffffffff\n");
+    proc_printf(buf, "CapEff:\t000001ffffffffff\n");
+    proc_printf(buf, "CapBnd:\t000001ffffffffff\n");
+    proc_printf(buf, "CapAmb:\t0000000000000000\n");
+    proc_printf(buf, "NoNewPrivs:\t0\n");
+    proc_printf(buf, "Seccomp:\t0\n");
+
+    unlock(&task->group->lock);
+    unlock(&task->general_lock);
+    proc_put_task(task);
+    return 0;
+}
+
+// User-namespace uid/gid maps + setgroups. We don't implement user namespaces,
+// but rootless container runtimes (podman/crun) write these during setup and
+// abort without them ("cannot write setgroups file: ... no such file"). Accept
+// writes (no-op) and read back a permissive identity map / "allow".
+static int proc_pid_idmap_show(struct proc_entry *UNUSED(entry), struct proc_data *buf) {
+    proc_printf(buf, "         0          0 4294967295\n");
+    return 0;
+}
+static ssize_t proc_pid_idmap_pwrite(struct proc_entry *UNUSED(entry), struct proc_data *buf, off_t UNUSED(offset)) {
+    return buf->size; // accept and discard the mapping
+}
+static int proc_pid_setgroups_show(struct proc_entry *UNUSED(entry), struct proc_data *buf) {
+    proc_printf(buf, "allow\n");
+    return 0;
+}
+static ssize_t proc_pid_setgroups_pwrite(struct proc_entry *UNUSED(entry), struct proc_data *buf, off_t UNUSED(offset)) {
+    return buf->size; // accept "deny"/"allow" no-op
+}
+
+// /proc/<pid>/mounts + /proc/<pid>/mountinfo, generated from the global mount
+// table (iSH has no per-process mount namespaces). podman/runc require these:
+// containers/storage parses /proc/self/mountinfo to decide whether a path (e.g.
+// the container's userdata/shm) is already mounted, and aborts with "open
+// /proc/self/mountinfo: no such file or directory" when it's missing.
+static void proc_mount_point(const struct mount *mount, const char **point) {
+    *point = (mount->point == NULL || mount->point[0] == '\0') ? "/" : mount->point;
+}
+// /proc/<pid>/cgroup. iSH has no cgroups; report the unified-hierarchy root so
+// crun/podman stop erroring ("open /proc/self/cgroup: no such file or
+// directory") when probing cgroup membership.
+static int proc_pid_cgroup_show(struct proc_entry *UNUSED(entry), struct proc_data *buf) {
+    proc_printf(buf, "0::/\n");
+    return 0;
+}
+static int proc_pid_mounts_show(struct proc_entry *UNUSED(entry), struct proc_data *buf) {
+    struct mount *mount;
+    lock(&mounts_lock);
+    list_for_each_entry(&mounts, mount, mounts) {
+        const char *point; proc_mount_point(mount, &point);
+        const char *src = (mount->source && mount->source[0]) ? mount->source : mount->fs->name;
+        const char *opts = (mount->flags & MS_READONLY_) ? "ro,relatime" : "rw,relatime";
+        proc_printf(buf, "%s %s %s %s 0 0\n", src, point, mount->fs->name, opts);
+    }
+    unlock(&mounts_lock);
+    return 0;
+}
+static int proc_pid_mountinfo_show(struct proc_entry *UNUSED(entry), struct proc_data *buf) {
+    struct mount *mount;
+    int id = 1;
+    lock(&mounts_lock);
+    list_for_each_entry(&mounts, mount, mounts) {
+        const char *point; proc_mount_point(mount, &point);
+        const char *src = (mount->source && mount->source[0]) ? mount->source : mount->fs->name;
+        const char *opts = (mount->flags & MS_READONLY_) ? "ro,relatime" : "rw,relatime";
+        // id parent major:minor root mountpoint opts - fstype source superopts
+        proc_printf(buf, "%d %d 0:%d / %s %s - %s %s %s\n",
+                id + 10, id == 1 ? 1 : 11, id, point, opts, mount->fs->name, src, opts);
+        id++;
+    }
+    unlock(&mounts_lock);
+    return 0;
+}
+
 struct proc_children proc_pid_children = PROC_CHILDREN({
     {"auxv", .show = proc_pid_auxv_show},
+    {"cgroup", .show = proc_pid_cgroup_show},
     {"cmdline", .show = proc_pid_cmdline_show},
     {"cwd", S_IFLNK, .readlink = proc_pid_cwd_readlink},
     {"exe", S_IFLNK, .readlink = proc_pid_exe_readlink},
     {"fd", S_IFDIR, .readdir = proc_pid_fd_readdir},
+    {"gid_map", S_IFREG | 0644, .show = proc_pid_idmap_show, .pwrite = proc_pid_idmap_pwrite},
     {"maps", .show = proc_pid_maps_show},
     {"mem", .pread = proc_pid_mem_pread, .pwrite = proc_pid_mem_pwrite},
+    {"mountinfo", .show = proc_pid_mountinfo_show},
+    {"mounts", .show = proc_pid_mounts_show},
+    {"setgroups", S_IFREG | 0644, .show = proc_pid_setgroups_show, .pwrite = proc_pid_setgroups_pwrite},
     {"stat", .show = proc_pid_stat_show},
     {"statm", .show = proc_pid_statm_show},
+    {"status", .show = proc_pid_status_show},
     {"task", S_IFDIR, .readdir = proc_pid_task_readdir},
+    {"uid_map", S_IFREG | 0644, .show = proc_pid_idmap_show, .pwrite = proc_pid_idmap_pwrite},
 });
 
 struct proc_dir_entry proc_pid = {NULL, S_IFDIR,
