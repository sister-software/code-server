+// reads them through a signalfd in its epoll loop instead of a handler; without
+// it conmon aborts ("Failed to create signalfd: Function not implemented") before
+// it can start the container. We back the signalfd by the caller thread's pending
+// signal set (current->pending + current->queue). iSH's poll_wait re-checks fds
+// on a bounded (~1s) timeout, so a blocked-but-pending signal becomes readable
+// without hooking signal delivery; the consuming read dequeues it.
+
+// Linux ABI: struct signalfd_siginfo is 128 bytes.
+struct signalfd_siginfo_ {
+    uint32_t ssi_signo;
+    int32_t  ssi_errno;
+    int32_t  ssi_code;
+    uint32_t ssi_pid;
+    uint32_t ssi_uid;
+    int32_t  ssi_fd;
+    uint32_t ssi_tid;
+    uint32_t ssi_band;
+    uint32_t ssi_overrun;
+    uint32_t ssi_trapno;
+    int32_t  ssi_status;
+    int32_t  ssi_int;
+    uint64_t ssi_ptr;
+    uint64_t ssi_utime;
+    uint64_t ssi_stime;
+    uint64_t ssi_addr;
+    uint16_t ssi_addr_lsb;
+    uint8_t  pad[46];
+};
+
+static struct fd_ops signalfd_ops;
+
+// Pull one pending signal in `mask` off the current thread's queue, filling out.
+// Must hold current->sighand->lock. Returns the signal number, or 0 if none.
+static int signalfd_dequeue(sigset_t_ mask, struct signalfd_siginfo_ *out) {
+    struct sigqueue *sigqueue, *tmp;
+    list_for_each_entry_safe(&current->queue, sigqueue, tmp, queue) {
+        int sig = sigqueue->info.sig;
+        if (!sigset_has(mask, sig))
+            continue;
+        list_remove(&sigqueue->queue);
+        sigset_del(&current->pending, sig);
+        memset(out, 0, sizeof(*out));
+        out->ssi_signo = sig;
+        out->ssi_errno = sigqueue->info.sig_errno;
+        out->ssi_code = sigqueue->info.code;
+        // kill/child share the leading pid/uid layout.
+        out->ssi_pid = sigqueue->info.child.pid;
+        out->ssi_uid = sigqueue->info.child.uid;
+        out->ssi_status = sigqueue->info.child.status;
+        free(sigqueue);
+        return sig;
+    }
+    return 0;
+}
+
+static ssize_t signalfd_read(struct fd *fd, void *buf, size_t bufsize) {
+    if (bufsize < sizeof(struct signalfd_siginfo_))
+        return _EINVAL;
+    sigset_t_ mask = fd->signalfd.mask;
+    size_t count = bufsize / sizeof(struct signalfd_siginfo_);
+    struct signalfd_siginfo_ *items = buf;
+
+    for (;;) {
+        size_t n = 0;
+        lock(&current->sighand->lock);
+        while (n < count && (current->pending & mask)) {
+            if (signalfd_dequeue(mask, &items[n]) == 0)
+                break;
+            n++;
+        }
+        unlock(&current->sighand->lock);
+        if (n > 0)
+            return n * sizeof(struct signalfd_siginfo_);
+        if (fd->flags & O_NONBLOCK_)
+            return _EAGAIN;
+        // No matching signal yet. Wait briefly and re-check — poll_wait's bounded
+        // re-poll is the normal path (conmon polls), this just avoids a busy spin
+        // for the rare blocking read.
+        struct timespec ts = {.tv_sec = 1, .tv_nsec = 0};
+        lock(&fd->lock);
+        int werr = wait_for(&fd->cond, &fd->lock, &ts);
+        unlock(&fd->lock);
+        if (werr == _EINTR)
+            return _EINTR;
+    }
+}
+
+static int signalfd_poll(struct fd *fd) {
+    int types = 0;
+    lock(&current->sighand->lock);
+    if (current->pending & fd->signalfd.mask)
+        types |= POLL_READ;
+    unlock(&current->sighand->lock);
+    return types;
+}
+
+static struct fd_ops signalfd_ops = {
+    .read = signalfd_read,
+    .poll = signalfd_poll,
+};
+
+fd_t sys_signalfd4(fd_t fd_no, addr_t mask_addr, dword_t mask_size, int_t flags) {
+    STRACE("signalfd4(%d, %#x, %d, %#x)", fd_no, mask_addr, mask_size, flags);
+    sigset_t_ mask;
+    if (user_get_sigset(mask_addr, mask_size, &mask))
+        return _EINVAL;
+
+    if (fd_no != -1) {
+        // Update the mask on an existing signalfd.
+        struct fd *fd = f_get(fd_no);
+        if (fd == NULL || fd->ops != &signalfd_ops)
+            return _EINVAL;
+        fd->signalfd.mask = mask;
+        return fd_no;
+    }
+
+    struct fd *fd = adhoc_fd_create(&signalfd_ops);
+    if (fd == NULL)
+        return _ENOMEM;
+    fd->signalfd.mask = mask;
+    return f_install(fd, flags);
+}
