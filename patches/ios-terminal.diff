+
+interface IosBridge {
+	postMessage(msg: Record<string, unknown>): Promise<Record<string, unknown>>;
+}
+
+function iosBridge(): IosBridge | undefined {
+	const w = window as unknown as { webkit?: { messageHandlers?: { terminal?: IosBridge } } };
+	return w.webkit?.messageHandlers?.terminal;
+}
+
+function iosInputBridge(): { postMessage(msg: Record<string, unknown>): void } | undefined {
+	const w = window as unknown as { webkit?: { messageHandlers?: { terminalInput?: { postMessage(msg: Record<string, unknown>): void } } } };
+	return w.webkit?.messageHandlers?.terminalInput;
+}
+
+class IosPty extends BasePty implements ITerminalChildProcess {
+	private _started = false;
+
+	constructor(
+		id: number,
+		shouldPersist: boolean,
+		private readonly _cols: number,
+		private readonly _rows: number,
+		@ITerminalLogService _logService: ITerminalLogService,
+	) {
+		super(id, shouldPersist);
+	}
+
+	async start(): Promise<ITerminalLaunchError | ITerminalLaunchResult | undefined> {
+		if (this._started) { return undefined; }
+
+		IosTerminalBackend._onData(this.id, (data: string) => this.handleData(data));
+		IosTerminalBackend._onExit(this.id, (_code: number) => {
+			this.handleExit(_code);
+			this.dispose();
+		});
+
+		const bridge = iosBridge();
+		if (!bridge) {
+			return { message: 'ios terminal bridge unavailable' };
+		}
+		const result = await bridge.postMessage({
+			op: 'terminal-open',
+			id: this.id, cols: this._cols, rows: this._rows
+		});
+
+		if (!result?.ok) {
+			return { message: (result?.error as string) || 'terminal-open failed' };
+		}
+
+		this._started = true;
+		return undefined;
+	}
+
+	input(data: string): void {
+		iosInputBridge()?.postMessage({ op: 'terminal-input', id: this.id, data });
+	}
+
+	resize(cols: number, rows: number): void {
+		iosInputBridge()?.postMessage({ op: 'terminal-resize', id: this.id, cols, rows });
+	}
+
+	shutdown(_immediate: boolean): void {
+		iosBridge()?.postMessage({ op: 'terminal-close', id: this.id });
+		this.dispose();
+	}
+
+	sendSignal(_signal: string): void { /* no-op */ }
+
+	processBinary(_e: string): Promise<void> { return Promise.resolve(); }
+	async clearBuffer(): Promise<void> {}
+	async acknowledgeDataEvent(_charCount: number): Promise<void> {}
+	async setUnicodeVersion(_version: '6' | '11'): Promise<void> {}
+	async refreshProperty<T extends ProcessPropertyType>(_type: T): Promise<IProcessPropertyMap[T]> { throw new Error('not supported'); }
+	async updateProperty<T extends ProcessPropertyType>(_type: T, _value: IProcessPropertyMap[T]): Promise<void> {}
+}
+
+class IosTerminalBackend extends BaseTerminalBackend implements ITerminalBackend {
+	readonly remoteAuthority: string | undefined = undefined;
+
+	private static _dataSubs = new Map<number, (data: string) => void>();
+	private static _exitSubs = new Map<number, (code: number) => void>();
+	private static _inited = false;
+
+	private readonly _whenReady = new DeferredPromise<void>();
+	get whenReady(): Promise<void> { return this._whenReady.p; }
+	setReady(): void { this._whenReady.complete(); }
+
+	private readonly _ptys: Map<number, IosPty> = new Map();
+	private readonly _onDidRequestDetach = this._register(new Emitter<{ requestId: number; workspaceId: string; instanceId: number }>());
+	readonly onDidRequestDetach = this._onDidRequestDetach.event;
+
+	constructor(
+		@IInstantiationService private readonly _instantiationService: IInstantiationService,
+		@ITerminalLogService logService: ITerminalLogService,
+		@ICommandService _commandService: ICommandService,
+		@IStorageService _storageService: IStorageService,
+		@IWorkspaceContextService workspaceContextService: IWorkspaceContextService,
+		@IConfigurationResolverService configurationResolverService: IConfigurationResolverService,
+		@IHistoryService historyService: IHistoryService,
+		@IConfigurationService _configurationService: IConfigurationService,
+		@IStatusbarService statusBarService: IStatusbarService,
+	) {
+		const stub = { onPtyHostExit: Event.None, onPtyHostStart: Event.None, onPtyHostUnresponsive: Event.None, onPtyHostResponsive: Event.None, onPtyHostRequestResolveVariables: Event.None, restartPtyHost: async () => {}, acceptPtyHostResolvedVariables: async () => {}, getProfiles: async () => [] as ITerminalProfile[] };
+		super(stub, logService, historyService, configurationResolverService, statusBarService, workspaceContextService);
+	}
+
+	static initBridge(): void {
+		if (IosTerminalBackend._inited) { return; }
+		IosTerminalBackend._inited = true;
+		const w = window as unknown as Record<string, unknown>;
+		w.__codeServerBridgeTerminal = {
+			onData(id: number, data: string) {
+				IosTerminalBackend._dataSubs.get(id)?.(data);
+			},
+			onExit(id: number, code: number) {
+				IosTerminalBackend._exitSubs.get(id)?.(code);
+				IosTerminalBackend._dataSubs.delete(id);
+				IosTerminalBackend._exitSubs.delete(id);
+			}
+		};
+	}
+
+	static _onData(id: number, cb: (data: string) => void): void { IosTerminalBackend._dataSubs.set(id, cb); }
+	static _onExit(id: number, cb: (code: number) => void): void { IosTerminalBackend._exitSubs.set(id, cb); }
+
+	async createProcess(
+		_shellLaunchConfig: IShellLaunchConfig,
+		_cwd: string,
+		cols: number,
+		rows: number,
+		_unicodeVersion: '6' | '11',
+		_env: IProcessEnvironment,
+		_options: ITerminalProcessOptions,
+		shouldPersist: boolean,
+	): Promise<ITerminalChildProcess> {
+		const id = this._ptys.size + 1;
+		const pty = this._instantiationService.createInstance(IosPty, id, shouldPersist, cols, rows);
+		this._ptys.set(id, pty);
+		return pty;
+	}
+
+	async installAutoReply(_match: string, _reply: string): Promise<void> {}
+	async uninstallAllAutoReplies(): Promise<void> {}
+
+	attachToProcess(_id: number): Promise<ITerminalChildProcess | undefined> { return Promise.resolve(undefined); }
+	attachToRevivedProcess(_id: number): Promise<ITerminalChildProcess | undefined> { return Promise.resolve(undefined); }
+	listProcesses(): Promise<IProcessDetails[]> { return Promise.resolve([]); }
+	getLatency(): Promise<IPtyHostLatencyMeasurement[]> { return Promise.resolve([]); }
+	getDefaultSystemShell(_osOverride?: OperatingSystem): Promise<string> { return Promise.resolve('shell'); }
+	getProfiles(_profiles: unknown, _defaultProfile: unknown, _includeDetectedProfiles?: boolean): Promise<ITerminalProfile[]> { return Promise.resolve([]); }
+	getWslPath(_original: string, _direction: 'unix-to-win' | 'win-to-unix'): Promise<string> { return Promise.resolve(''); }
+	getEnvironment(): Promise<IProcessEnvironment> { return Promise.resolve({}); }
+	getShellEnvironment(): Promise<IProcessEnvironment | undefined> { return Promise.resolve(undefined); }
+	setTerminalLayoutInfo(_layoutInfo?: ITerminalsLayoutInfoById): Promise<void> { return Promise.resolve(); }
+	updateTitle(_id: number, _title: string, _titleSource: TitleEventSource): Promise<void> { return Promise.resolve(); }
+	updateIcon(_id: number, _userInitiated: boolean, _icon: TerminalIcon, _color?: string): Promise<void> { return Promise.resolve(); }
+	setNextCommandId(_id: number, _commandLine: string, _commandId: string): Promise<void> { return Promise.resolve(); }
+	getTerminalLayoutInfo(): Promise<ITerminalsLayoutInfo | undefined> { return Promise.resolve(undefined); }
+	getPerformanceMarks(): Promise<PerformanceMark[]> { return Promise.resolve([]); }
+	reduceConnectionGraceTime(): Promise<void> { return Promise.resolve(); }
+	requestDetachInstance(_workspaceId: string, _instanceId: number): Promise<IProcessDetails | undefined> { return Promise.resolve(undefined); }
+	acceptDetachInstanceReply(_requestId: number, _persistentProcessId?: number): Promise<void> { return Promise.resolve(); }
+	persistTerminalState(): Promise<void> { return Promise.resolve(); }
+}
+
+export class IosTerminalBackendContribution implements IWorkbenchContribution {
+	static readonly ID = 'iosTerminalBackend';
+
+	constructor(
+		@IInstantiationService instantiationService: IInstantiationService,
+		@ITerminalInstanceService terminalInstanceService: ITerminalInstanceService
+	) {
+		if (iosBridge() && (window as unknown as Record<string, unknown>).__codeServerBridge) {
+			IosTerminalBackend.initBridge();
+			const backend = instantiationService.createInstance(IosTerminalBackend);
+			Registry.as<ITerminalBackendRegistry>(TerminalExtensions.Backend).registerTerminalBackend(backend);
+			terminalInstanceService.didRegisterBackend(backend);
+		}
+	}
+}
