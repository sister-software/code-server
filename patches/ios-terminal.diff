+import { IStorageService } from '../../../../platform/storage/common/storage.js';
+import { IProcessPropertyMap, IPtyHostLatencyMeasurement, IShellLaunchConfig, ITerminalBackend, ITerminalBackendRegistry, ITerminalChildProcess, ITerminalLaunchError, ITerminalLaunchResult, ITerminalLogService, ITerminalProcessOptions, ITerminalProfile, ITerminalsLayoutInfo, ITerminalsLayoutInfoById, ProcessPropertyType, TerminalExtensions, TerminalIcon, TitleEventSource } from '../../../../platform/terminal/common/terminal.js';
